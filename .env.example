# Firebase web app config (Firebase console > Project settings > Your apps).
# These are public identifiers, not secrets; security comes from Firebase Auth + the Apps Script checks.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Apps Script web app URL ending in /exec
VITE_APPS_SCRIPT_URL=

# DEV ONLY: skip login when running npm run dev (ignored in production builds)
VITE_SKIP_AUTH=true
